<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Dictation and voice mode. Both run on the device: the gateway has no
         audio surface, so nothing recorded ever leaves as audio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Lets the app raise the system installer for a release it downloaded. It
      does not install anything: Android shows its own confirmation, and the
      user grants this app the right to ask on the settings page the update
      screen links to. Without it the intent is refused outright.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Package visibility for the speech and text-to-speech engines. Without
      these queries the recognizer reports itself unavailable on API 30+, since
      the app cannot see the package that implements it.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!--
      REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is deliberately NOT declared.
      Google Play restricts it to a short list of app types (alarms, VoIP,
      companion devices); an agent client is not one, and declaring it fails
      review. The app instead sends the user to the battery-optimisation
      settings list, which needs no permission — see SystemPermissions.
    -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Hermes">

        <!--
          windowSoftInputMode belongs here, on the activity. It sat on
          <application> from the first release, where the runtime never reads
          it — so the activity ran on the unspecified default and the system
          chose adjustPan, sliding the whole window up to keep the focused
          field in view. Every change made to its value was a change to an
          attribute nothing consulted.

          adjustResize is the documented pairing for an edge-to-edge activity
          that applies the keyboard inset itself: the window is not actually
          resized when it draws behind the system bars, the IME inset is
          reported instead, and the Scaffold's safeDrawing insets pay for it
          once. Pan and padding together were the doubled lift.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.RunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".service.ApprovalActionReceiver"
            android:exported="false" />

        <!--
          Hands the camera app a writable target for a capture. A file:// Uri
          has been illegal to pass between apps since API 24, and CAMERA is
          deliberately not declared: an app that declares it must then hold the
          runtime grant before ACTION_IMAGE_CAPTURE will run, which is a
          permission prompt for something the camera app already does itself.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
