<?xml version="1.0" encoding="utf-8"?>
<!--
  The Hermes Agent desktop icon, used with permission of its MIT licence.
  Attribution lives in NOTICE; see THIRD-PARTY.md for the upstream copyright.

  No <monochrome> layer: that path flattens the drawable to a single tint, and
  this artwork is a detailed illustration rather than a silhouette, so a themed
  icon would render as a solid blob. Omitting it makes launchers keep the full
  colour icon instead.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
