<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device.

  The stored settings contain the gateway bearer token, sealed with a key that
  lives in this device's Keystore. Copying that blob to another device or to
  cloud backup produces something undecryptable at best, and moves a live
  credential off-device at worst. Both transfer paths are refused outright; the
  user re-enters the address and key on a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
