<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the capture directory is shared, and only inside the cache: a photo
  taken for a message is scratch, and the OS may reclaim it once it has been
  sent. Widening this to the whole cache or to files/ would expose the token
  store's directory to any app handed a grant.
-->
<paths>
    <cache-path name="captures" path="captures/" />
    <!--
      The downloaded release, readable by the system installer for as long as
      the install intent lives. Scoped to its own directory for the same reason
      as the captures above.
    -->
    <cache-path name="updates" path="updates/" />
</paths>
